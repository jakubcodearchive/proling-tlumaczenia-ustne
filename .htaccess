# =======================================
# .htaccess for tlumaczenia-ustne.biz
# Simple, SEO-friendly, secure, and clean
# =======================================

# Enable the rewrite engine (required for most rules)
RewriteEngine On

# ---------------------------------------
# 1. Force HTTPS and remove "www"
# ---------------------------------------
# Redirect all requests to the https:// version without www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://tlumaczenia-ustne.biz%{REQUEST_URI} [L,R=301]

# ---------------------------------------
# 2. Remove .php extension (optional "pretty URLs")
# ---------------------------------------
# If a user visits /page-name/, serve page-name.php
# but only if the .php file actually exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)/$ $1.php [L]

# ---------------------------------------
# 3. Default index file
# ---------------------------------------
DirectoryIndex index.php

# ---------------------------------------
# 4. Enable browser caching for static files
# ---------------------------------------
# Helps SEO by improving load time (PageSpeed)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ---------------------------------------
# 5. Basic compression (faster page loads)
# ---------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ---------------------------------------
# 6. Canonical consistency (optional safeguard)
# ---------------------------------------
# Redirect trailing slashes (except directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ---------------------------------------
# 7. Security and hygiene
# ---------------------------------------
# Disable directory listing
Options -Indexes

# Protect .htaccess itself
<Files ".htaccess">
  Order Allow,Deny
  Deny from all
</Files>

# ---------------------------------------
# 8. Sitemap location for search engines
# ---------------------------------------
# Helps crawlers find your sitemap automatically
Sitemap: https://tlumaczenia-ustne.biz/sitemap.xml
